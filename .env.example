# Neon PostgreSQL Connection (Pooled for Serverless API Routes)
DATABASE_URL="postgresql://neondb_owner:your_password_here@ep-example-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"

# Neon PostgreSQL Direct Connection (Unpooled for Schema Migrations & DDL)
DATABASE_URL_UNPOOLED="postgresql://neondb_owner:your_password_here@ep-example.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"

# Serverless Session Secret (HMAC-SHA256 signing for session cookies, minimum 32 characters)
CADENCE_SESSION_SECRET="cadence-secret-salt-development-key-32b-minimum"

# Neon Environment Branch
NEON_BRANCH="production"
